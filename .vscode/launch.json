{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug National Park Agent",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "nationalparkagent.main:app",
        "--reload"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true
    }
  ]
}
